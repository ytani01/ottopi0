[servo]
# ピン番号: 逆回転の場合は '-' を**後ろに**つける
#pins = "22,27-"
pins = "20-,26,19-,16"

[servo.funcs]
_prefix = "ms:.4 st:30"

xxx = "ms:1 mv:x,x,x,x mv:n,n,n,n fn:xxx"  # recursive sample

home = "ca mv:-30,0,0,20 mv:0,0,0,0 mv:20,0,0,-30 mv:0,0,0,0"

fw = "ms:.2  mv:-30,0,0,20  mv:-30,20,-20,20  mv:0,20,-20,0  mv:20,0,0,-30  mv:20,-20,20,-30  mv:0,-20,20,0"
bw = "ms:.3  mv:20,0,0,-30  mv:20,20,-20,-30  mv:0,20,-20,0  mv:-30,0,0,20  mv:-30,-20,20,20  mv:0,-20,20,0"

left  = "ms:.3  mv:-30,0,0,20  mv:-30,-20,-20,20  mv:0,-20,-20,0  mv:20,-20,-20,-30  mv:20,0,0,-30  mv:0,0,0,0"
right = "ms:.3  mv:20,0,0,-30  mv:20,-20,-20,-30  mv:0,-20,-20,0  mv:-30,-20,-20,20  mv:-30,0,0,20  mv:0,0,0,0"

happy = "ms:.2  mv:-15,0,0,-45  mv:0,0,0,0  mv:-45,0,0,-15  mv:0,0,0,0"
surprise = "ms:.15  st:20  mv:45,0,0,45  sl:.3  mv:0,0,0,0"

hi  = "ms:.3  mv:-30,0,0,20 mv:90,-90,0,20  sl:.3 ms:.1 mv:80,-90,0,20 mv:90,-90,0,20 mv:80,-90,0,20 mv:90,-90,0,20  sl:.5 ms:.5 mv:-50,0,0,20 mv:0,0,0,0"

bye = "ms:.3  mv:-30,0,0,20 mv:90,-90,0,20  sl:.3 ms:.1 mv:90,-70,0,20 mv:90,-90,0,20 mv:90,-70,0,20 mv:90,-90,0,20  mv:90,-70,0,20 mv:90,-90,0,20 sl:.5 ms:.5 mv:-50,0,0,20 mv:0,0,0,0"

sumo = "ms:.4  mv:-30,0,0,20 mv:60,0,0,30 sl:.5 ms:.2 mv:20,0,0,0 mv:0,0,0,0  sl:1 ms:.4  mv:20,0,0,-30 mv:30,0,0,60  sl:.5 ms:.2  mv0,0,0,20 mv:0,0,0,0"

# TBD
servo0_up   = "mr:5,0,0,0"
servo0_down = "mr:-5,0,0,0"
servo1_up   = "mr:0,5,0,0"
servo1_down = "mr:0,-5,0,0"
servo2_up   = "mr:0,0,5,0"
servo2_down = "mr:0,0,-5,0"
servo3_up   = "mr:0,0,0,5"
servo3_down = "mr:0,0,0,-5"

[jsonrpc]

[jsonrpc.server]
# url = {proto}://{host}:{port}{apipath]
proto = "http"
host = "0.0.0.0"
port = 8000
apipath = "/api"

[jsonrpc.client]

[jsonrpc.client.cli]
history_file = "~/ottopi0_cli.hist"

[jsonrpc.client.bluetooth]
dev_keyword = "8BitDo,Keyboard"
mr_prefix = "ms:0.3 st:10 mr:"  # TBD

[jsonrpc.client.bluetooth.keys]
KEY_S = "fn:home"

KEY_C = "fn:fw"
KEY_D = "fn:bw"
KEY_E = "fn:left"
KEY_F = "fn:right"

KEY_G = "fn:happy"
KEY_J = "fn:surprise"
KEY_H = "fn:hi"
KEY_I = "fn:bye"

[jsonrpc.client.bluetooth.mr_keys]  # TBD
