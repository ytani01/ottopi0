##### Servo
[servo]
# ピン番号: 逆回転の場合は '-' を**後ろに**つける
#pins = "22,27-"  # rpi4b
pins = "20-,26,19-,16"  # rpi0w
#pins = "16-,19,26-,20"  # rpi3b

[servo.funcs]
#_prefix = "st:30 ms:.4"
_prefix = ""

auto-stop = "zz sl:.1 f:surprise ms:.3 f:backward-rl f:turn-r f:turn-r"

home = "st:30 mv:-30,c,c,20 mv:c,c,c,c mv:20,c,c,-30 mv:c,c,c,c"


forward-r     = "mv:-30,c,c,20  mv:=,30,-30,=  mv:c,=,=,c"
forward-r-end = "mv:20,10,-10,-30  sl:.1  mv:c,c,c,c"
forward-l     = "mv:20,c,c,-30  mv:=,-30,30,=  mv:c,=,=,c"
forward-l-end = "mv:-30,-10,10,20  sl:.1  mv:c,c,c,c"

forward-rl = "f:forward-r ; f:forward-l"
forward-lr = "f:forward-l ; f:forward-r"

forward-rl-seq5  = "f:forward-rl ; f:forward-rl ; f:forward-rl ; f:forward-rl ; f:forward-rl"
forward-rl-seq10 = "f:forward-rl-seq5 f:forward-rl-seq5"

cmd-forward-prefix  = "zz ms:.2"
cmd-forward-postfix = "ms:.5 f:forward-l-end"
cmd-forward = "f:cmd-forward-prefix ; f:forward-rl-seq10 ; f:cmd-forward-postfix"


backward-l     = "mv:20,c,c,-30  mv:20,30,-30,-30  mv:c,=,=,c"
backward-l-end = "mv:-30,-10,10,20  sl:.1  mv:c,c,c,c"
backward-r     = "mv:-30,c,c,20  mv:-30,-30,30,20  mv:c,=,=,c"
backward-r-end = "mv:20,10,-10,-30  sl:.1  mv:c,c,c,c"

backward-rl = "f:backward-r ; f:backward-l"
backward-lr = "f:backward-l ; f:backward-r"

backward-lr-seq5 = "f:backward-lr ; f:backward-lr ; f:backward-lr ; f:backward-lr ; f:backward-lr"

cmd-backward-prefix  = "zz ms:.3"
cmd-backward-postfix = "ms:.5 f:backward-r-end"
cmd-backward = "f:cmd-backward-prefix ; f:backward-lr-seq5 ; f:cmd-backward-postfix"


turn-l = "mv:-30,c,c,20  mv:-30,-20,-20,20  mv:c,-20,-20,c  mv:20,-20,-20,-30  mv:20,c,c,-30  mv:c,c,c,c"
turn-r = "mv:20,c,c,-30  mv:20,-20,-20,-30  mv:c,-20,-20,c  mv:-30,-20,-20,20  mv:-30,c,c,20  mv:c,c,c,c"

turn-l-seq5  = "f:turn-l ; f:turn-l ; f:turn-l ; f:turn-l ; f:turn-l"
turn-l-seq10 = "f:turn-l-seq5 ; f:turn-l-seq5"
turn-r-seq5  = "f:turn-r ; f:turn-r ; f:turn-r ; f:turn-r ; f:turn-r"
turn-r-seq10 = "f:turn-r-seq5 ; f:turn-r-seq5"

cmd-turn-prefix = "zz ms:.4"
cmd-turn-l = "f:cmd-turn-prefix f:turn-l-seq10"
cmd-turn-r = "f:cmd-turn-prefix f:turn-r-seq10"


slide-l = "mv:c,c,c,-60 mv:-30,=,=,-30 mv:-60,=,=,c mv:c,c,c,c"
slide-r = "mv:-60,c,c,c mv:-30,=,=,-30 mv:c,=,=,-60 mv:c,c,c,c"


happy-l = "mv:-15,c,c,-45  mv:c,c,c,c"
happy-r = "mv:-45,c,c,-15  mv:c,c,c,c"
happy = "f:happy-l f:happy-r"
surprise = "ms:.15  st:20  mv:45,c,c,45  sl:.3  mv:c,c,c,c"

hi  = "ms:.3  mv:-30,c,c,20 mv:90,-90,c,20  sl:.3 ms:.1 mv:80,-90,c,20 mv:90,-90,c,20 mv:80,-90,c,20 mv:90,-90,c,20  sl:.5 ms:.5 mv:-50,c,c,20 mv:c,c,c,c"

bye = "ms:.3  mv:-30,c,c,20 mv:90,-90,c,20  sl:.3 ms:.1 mv:90,-70,c,20 mv:90,-90,c,20 mv:90,-70,c,20 mv:90,-90,c,20  mv:90,-70,c,20 mv:90,-90,c,20 sl:.5 ms:.5 mv:-50,c,c,20 mv:c,c,c,c"

toes-l = "mv:c,c,c,c  mv:20,=,=,= sl:.1 mv:c,c,c,c"
toes-r = "mv:c,c,c,c  mv:=,=,=,20 sl:.1 mv:c,c,c,c"

heel-l = "mv:c,c,c,c  mv:-20,=,=,= sl:.1 mv:c,c,c,c"
heel-r = "mv:c,c,c,c  mv:=,=,=,-20 sl:.1 mv:c,c,c,c"

step-l = "f:toes-l f:toes-l f:heel-l f:heel-l"
step-r = "f:toes-r f:toes-r f:heel-r f:heel-r"

step1 = "f:toes-l f:toes-l f:heel-l f:heel-l  f:toes-r f:toes-r f:heel-r f:heel-r"

dance1 = "ms:.08 f:step-l ; ms:c.08 f:step-r"
dance2 = "ms:.2 f:happy f:happy"
dance3 = "ms:.2 sl:.1 f:surprise sl:.1 f:surprise sl:.1"
dance4 = "ms:.2 f:slide-r ; ms:.2 f:slide-l"
dance5 = "ms:.17 f:forward-rl ; ms:c.17 f:backward-lr"

dance-seq1 = "f:dance1 ; f:dance2 ; f:dance3: f:dance4: ; f:dance5 ; sl:.1 ; f:dance5 ; sl:.2"
dance-seq2 = "f:hi ; sl:.5 ; f:dance-seq1 ; ; sl:.5 ; f:bye ; ms:.2 f:turn-r ; ms:.2 f:turn-r"

sumo-r = "ms:.4 mv:-30,c,c,20 mv:80,c,c,30 sl:.5 ms:.1 mv:-30,c,c,20 ms:.5 mv:c,c,c,c"
sumo-l = "ms:.4 mv:20,c,c,-30 mv:30,c,c,80 sl:.5 ms:.1 mv:20,c,c,-30 ms:.5 mv:c,c,c,c"
sumo = "f:sumo-r ; sl:0.8 ; f:sumo-l ; sl:0.8"

[jrpc]

[jrpc.server]
# url = {proto}://{host}:{port}{apipath}
proto = "http"
host = "0.0.0.0"
port = 8000
apipath = "/api"

[jrpc.client]

[jrpc.client.cli]
history_file = "~/ottopi0_cli.hist"

[jrpc.client.bluetooth]
dev_keyword = "8BitDo,Keyboard"
mr_prefix = "ms:0.3 st:10 mr:"  # TBD

[jrpc.client.bluetooth.keys]
#
# 8BitDo micro
#  ---K--L----------R--M---
# |         N    O         |
# |   C                H   |
# | E   F            I   G |
# |   D                J   |
# |          *  S          |
#  ------------------------
#
KEY_S = "zz ms:.3 f:home"

KEY_C = "f:cmd-forward"
KEY_D = "f:cmd-backward ; f:home"
KEY_E = "f:cmd-turn-l"
KEY_F = "f:cmd-turn-r"

KEY_G = "ms:.2 f:happy"
KEY_J = "f:surprise"
KEY_H = "f:hi"
KEY_I = "f:bye"

KEY_M-KEY_E = "ms:.2 f:slide-l"
KEY_M-KEY_F = "ms:.2 f:slide-r"

KEY_R-KEY_E = "ms:.1 f:step-l"
KEY_R-KEY_F = "ms:.1 f:step-r"

KEY_N = "f:dance-seq2"
KEY_O = "f:sumo"

[jrpc.client.webui]
# url = {proto}://{host}:{port}{apipath}
proto = "http"
host = "0.0.0.0"
port = 5000
apipath = "/api/cmd"

[jrpc.client.webui.jrpcsvr]
# url = {proto}://{host}:{port}{apipath}
proto = "http"
host = "localhost"
port = 8000
apipath = "/api"

[jrpc.client.webui.buttons]
forward = "f:cmd-forward"
backward = "f:cmd-backward"
left = "f:cmd-turn-l"
right = "f:cmd-turn-r"
stop = "zz ms:.3 f:home"

##### Auto pilot
[auto]

[auto.distance]
near = 200  # mm
far = 2000  # mm
