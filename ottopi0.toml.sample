[servo]
# ピン番号: 逆回転の場合は '-' を**後ろに**つける
pins = "22,27-"
#pins = "20-,26,19-,16"

[servo.funcs]
_prefix = "ms:.4 st:30"

home = "ca mv:-30,0,0,20 mv:0,0,0,0 mv:20,0,0,-30 mv:0,0,0,0"

forward    = "ms:.2  mv:-30,0,0,20  mv:-30,20,-20,20  mv:0,20,-20,0  mv:20,0,0,-30  mv:20,-20,20,-30  mv:0,-20,20,0"
backward   = "ms:.3  mv:20,0,0,-30  mv:20,20,-20,-30  mv:0,20,-20,0  mv:-30,0,0,20  mv:-30,-20,20,20  mv:0,-20,20,0"
turn_left  = "ms:.3  mv:-30,0,0,20  mv:-30,-20,-20,20  mv:0,-20,-20,0  mv:20,-20,-20,-30  mv:20,0,0,-30  mv:0,0,0,0"
turn_right = "ms:.3  mv:20,0,0,-30  mv:20,-20,-20,-30  mv:0,-20,-20,0  mv:-30,-20,-20,20  mv:-30,0,0,20  mv:0,0,0,0"

happy = "ms:.2  mv:-15,0,0,-45   mv:0,0,0,0  mv:-45,0,0,-15  mv:0,0,0,0"
surprise = "ms:.15  st:20  mv:45,0,0,45  sl:.3  mv:0,0,0,0"

hi_right  = "ms:.3 mv:-30,0,0,20 mv:90,-90,0,20  sl:.3 ms:.1 mv:80,-90,0,20 mv:90,-90,0,20 mv:80,-90,0,20 mv:90,-90,0,20  sl:.5 ms:.3 mv:-50,0,0,20 mv:0,0,0,0"

bye_right = "ms:.3 mv:-30,0,0,20 mv:90,-90,0,20  sl:.3 ms:.1 mv:90,-70,0,20 mv:90,-90,0,20 mv:90,-70,0,20 mv:90,-90,0,20  mv:90,-70,0,20 mv:90,-90,0,20 sl:.5 ms:.3 mv:0,0,0,20 mv:0,0,0,0"

servo0_up   = "mr:5,0,0,0"
servo0_down = "mr:-5,0,0,0"
servo1_up   = "mr:0,5,0,0"
servo1_down = "mr:0,-5,0,0"
servo2_up   = "mr:0,0,5,0"
servo2_down = "mr:0,0,-5,0"
servo3_up   = "mr:0,0,0,5"
servo3_down = "mr:0,0,0,-5"

[jsonrpc]

[jsonrpc.server]
# url = {proto}://{host}:{port}{apipath]
proto = "http"
host = "0.0.0.0"
port = 8000
apipath = "/api"

[jsonrpc.client]

[jsonrpc.client.cli]
history_file = "~/ottopi0_cli.hist"

[jsonrpc.client.bluetooth]
dev_keyword = "8BitDo,Keyboard"
mr_prefix = "ms:0.3 st:10 mr:"  # TBD

[jsonrpc.client.bluetooth.keys]
KEY_S = "home"
KEY_R = "forward"
KEY_L = "backward"
KEY_K = "turn_left"
KEY_M = "turn_right"
KEY_O = "happy"
KEY_N = "surprise"

[jsonrpc.client.bluetooth.mr_keys]  # TBD
KEY_C = [ 5, 0, 0, 0]
KEY_D = [-5, 0, 0, 0]
KEY_E = [0,  5, 0, 0]
KEY_F = [0, -5, 0, 0]
KEY_G = [0, 0,  5, 0]
KEY_I = [0, 0, -5, 0]
KEY_H = [0, 0, 0,  5]
KEY_J = [0, 0, 0, -5]
